# Copia este archivo como .env.local y completa los dos valores
# (Supabase → Project Settings → API). Usa la clave PÚBLICA (anon / publishable), nunca la secreta.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-CLAVE-PUBLICA

# Avisos push del dueño. Clave PÚBLICA que sale de:  npx web-push generate-vapid-keys
# (la privada NO va aquí; se sube como secreto a Supabase, ver README).
VITE_VAPID_PUBLIC_KEY=TU-CLAVE-VAPID-PUBLICA

# Barbería que se muestra en la raíz del sitio (la dirección corta, ej. barber-studio-593).
# Déjalo vacío para mostrar la página de Fade Studio en la raíz.
VITE_BARBERIA_POR_DEFECTO=barber-studio-593
# WhatsApp de soporte de Fade Studio (solo dígitos, con 56). Aparece cuando una suscripción vence.
VITE_SOPORTE_WHATSAPP=
